#include <stack>

void testaARQ_Arquivo()
{
    ARQ::Arquivo teste;
    teste.SetArquivo("C:/Tony/Projeto/Inscopia.dxf");
    size_t numLinhas = teste.GetLnTotal();
    std::cout << numLinhas << " linhas" << std::endl;
    char str[128];
